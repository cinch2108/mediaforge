{
  "name": "Mediaforge – Video & Audio Tools",
  "short_name": "Mediaforge",
  "description": "Convert, compress, trim, GIF, merge and record video and audio in your browser. No uploads.",
  "start_url": "/mediaforge/",
  "scope": "/mediaforge/",
  "display": "standalone",
  "background_color": "#0b0b14",
  "theme_color": "#0b0b14",
  "icons": [
